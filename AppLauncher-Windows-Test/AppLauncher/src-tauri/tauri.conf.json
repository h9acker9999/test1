{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppLauncher",
  "version": "1.0.0",
  "identifier": "com.example.applauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AppLauncher",
        "width": 520,
        "height": 430,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": "embedBootstrapper"
    }
  }
}